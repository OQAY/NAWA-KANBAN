# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill with your credentials
# Command: cp .env.example .env

# ============================================
# DATABASE (Supabase PostgreSQL)
# ============================================
# Recommended: Use Session Pooler (IPv4 compatible)
#
# Where to find:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Settings → Database → Connection string
# 4. Choose "Session pooler" tab
#
# Connection string format:
# postgresql://postgres.PROJECT_ID:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.your-project-id
DB_PASSWORD=your-supabase-password
DB_NAME=postgres

# Alternative: Direct Connection (requires IPv6)
# DB_HOST=db.xxxxx.supabase.co
# DB_USERNAME=postgres

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate a secure random string for production
# Example: openssl rand -base64 32

JWT_SECRET=your-jwt-secret-key-change-in-production

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
